{
  "name": "@tiro/desktop",
  "productName": "Tiro",
  "author": "The Plato",
  "description": "No more loss of fleeting ideas, thoughts, and knowledge",
  "private": true,
  "version": "4.9.14",
  "packageManager": "yarn@4.6.0",
  "main": ".vite/build/index.js",
  "scripts": {
    "copy-locales": "node ./scripts/copy-locales.js",
    "bump-version": "node ./scripts/bump-version.mjs",
    "env:pull": "node ./scripts/env-pull.mjs",
    "dev": "yarn copy-locales && electron-forge start",
    "package": "yarn copy-locales && electron-forge package",
    "make:mac": "yarn copy-locales && NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 electron-forge make --platform=darwin --arch=universal",
    "make:mac:qa": "yarn copy-locales && NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 electron-forge make --platform=darwin --arch=arm64",
    "make:window": "yarn workspace @plato-corp/audio-capture build:win && yarn copy-locales && NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 electron-forge make --platform=win32 --arch=x64",
    "publish:mac": "yarn copy-locales && NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 electron-forge publish --platform=darwin --arch=universal",
    "publish:window": "yarn workspace @plato-corp/audio-capture build:win && yarn copy-locales && NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 electron-forge publish --platform=win32 --arch=x64",
    "release:win": "node ./scripts/release-win.mjs",
    "publish:download-page": "node ./scripts/publish-download-page.mjs",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "yarn copy-locales && vitest run",
    "test:run": "yarn copy-locales && vitest run",
    "test:unit": "yarn copy-locales && vitest run",
    "test:smoke:offline-recording": "vitest run src/renderer/components/router/MainRouter/__tests__/MainRouter.startupRecordingToast.test.tsx src/main/services/__tests__/AudioRecordingManager.offlineContract.test.ts src/main/services/__tests__/OfflineRecordingPersistence.recoveryContract.test.ts src/renderer/contexts/__tests__/OfflineRecordingContext.offlineContract.test.tsx src/renderer/components/pages/OfflineRecordingRecoveryPage/__tests__/OfflineRecordingRecoveryPage.test.tsx",
    "test:smoke:native-audio-routing": "vitest run src/main/utils/__tests__/native-audio-frame-routing.contract.test.ts",
    "test:smoke:live-voice": "vitest run --config vitest.macminion.config.ts smoke/macminion/liveVoice.smoke.test.ts",
    "test:smoke:wiki-lint": "vitest run --config vitest.macminion.config.ts smoke/macminion/wikiLint.smoke.test.ts",
    "test:smoke:native-mic": "vitest run --config vitest.macminion.config.ts smoke/macminion/globalAudioStreaming.live.smoke.test.tsx",
    "test:smoke:offline-recording-upload": "vitest run --config vitest.macminion.config.ts smoke/macminion/offlineRecordingUpload.smoke.test.ts",
    "test:smoke:offline-recording-recovery-file": "vitest run --config vitest.macminion.config.ts smoke/macminion/offlineRecordingRecoveryFile.smoke.test.ts",
    "test:smoke": "yarn test:smoke:offline-recording && yarn test:smoke:native-audio-routing && yarn test:smoke:wiki-lint && yarn test:smoke:live-voice && yarn test:smoke:native-mic && yarn test:smoke:offline-recording-upload && yarn test:smoke:offline-recording-recovery-file",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "yarn copy-locales && tsc --noEmit --skipLibCheck"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
